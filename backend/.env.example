# Django
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL 16 in production; SQLite fallback for tests)
DATABASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# CSRF — origines HTTPS publiques (Railway/Render), requis pour les POST web en prod
# Ex. : CSRF_TRUSTED_ORIGINS=https://monexa-backend.up.railway.app,https://monexa.onrender.com
CSRF_TRUSTED_ORIGINS=

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# IA providers (optional; the mock pipeline works without these)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Django Admin / locale
LANGUAGE_CODE=fr
TIME_ZONE=Africa/Lome

# ── V2.1 — Trésorerie & passerelles Mobile Money ──
# Jours de marché boostés dans les prévisions (0=lundi … 6=dimanche), ex. « 5 » = samedi
MARKET_DAYS=5

# Passerelles de collecte (sandbox si vide ; production avec URL + clé)
TMONEY_COLLECTION_URL=
TMONEY_API_KEY=
TMONEY_API_SECRET=
MOOV_COLLECTION_URL=
MOOV_API_KEY=
MOOV_API_SECRET=
FLOOZ_COLLECTION_URL=
FLOOZ_API_KEY=
FLOOZ_API_SECRET=
# Secret HMAC des webhooks opérateurs (doit être fort en production)
GATEWAY_WEBHOOK_SECRET=change-me-webhook-secret
